@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">BudgetBook</h1>
    <p>Manage your Transactions</p>
    <div class="d-flex flex-column gap-2 align-items-center">
        <a class="w-25 btn btn-lg btn-primary" asp-area="" asp-controller="Transactions" asp-action="Index">Manage Transactions</a>
        <a class="w-25 btn btn-lg btn-danger" asp-area="" asp-controller="Categories" asp-action="Index">Manage Categories</a>
        <a class="w-25 btn btn-lg btn-success" asp-area="" asp-controller="Statistics" asp-action="Index">View Statistics</a>
    </div>
</div>
